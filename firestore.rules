rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /participants/{participantId} {
      allow read: if request.auth != null && request.auth.uid == participantId;
      allow write: if false;
      match /days/{dayId} {
        allow read: if request.auth != null && request.auth.uid == participantId;
        allow write: if false;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
